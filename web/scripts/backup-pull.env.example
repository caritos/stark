# Settings for web/scripts/pull-backups.sh when run by the launchd agent.
# Copy to ~/.config/stark/backup-pull.env, edit, then run web/scripts/install-backup-agent.sh.
# The file is sourced by bash: quote values that contain spaces.

# Required: user@host of the server, and the directory there that holds the backup sets.
REMOTE=deploy@host.example.com
REMOTE_DIR=stark/data/backups

# Local folder for the pulled sets (default $HOME/Backups/stark).
DEST=$HOME/Backups/stark
# Number of snapshots to keep locally (default 30).
#KEEP=30
# Identity file passed to ssh with -i (default: ssh's own choice).
#SSH_KEY=$HOME/.ssh/stark-pull
# Notify when the newest verified copy is older than this many days (default 3).
#STALE_DAYS=3
# Optional second destination; used only if it already exists as a directory.
MIRROR_DIR="/Volumes/Treasure Chest/backups/stark"
